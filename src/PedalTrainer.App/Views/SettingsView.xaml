<UserControl x:Class="PedalTrainer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,12">
            <TextBlock Text="CONFIGURAÇÕES" Style="{StaticResource SectionText}" />
            <TextBlock Text="Ajuste o rigor do treino, a janela do gráfico e qual controlador será lido."
                       Style="{StaticResource BodyText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Treino ================= -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="RIGOR DO TREINO" Style="{StaticResource SectionText}" />

                    <DockPanel Margin="0,14,0,0">
                        <TextBlock Text="Gatilho de frenagem" Style="{StaticResource CaptionText}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding BrakeTriggerPercent, StringFormat={}{0:0}%}"
                                   Style="{StaticResource CaptionText}"
                                   FontFamily="{StaticResource MonoFont}" />
                    </DockPanel>
                    <TextBlock Text="Quanto você precisa pisar no freio para o desafio começar."
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <Slider Style="{StaticResource FlatSlider}"
                            Minimum="1" Maximum="30"
                            Value="{Binding BrakeTriggerPercent}" />

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Banda de tolerância" Style="{StaticResource CaptionText}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ToleranceBandPercent, StringFormat={}{0:0}%}"
                                   Style="{StaticResource CaptionText}"
                                   FontFamily="{StaticResource MonoFont}" />
                    </DockPanel>
                    <TextBlock Text="Distância aceita entre a sua pressão e a do piloto de referência."
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <Slider Style="{StaticResource FlatSlider}"
                            Minimum="2" Maximum="25"
                            Value="{Binding ToleranceBandPercent}" />

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Janela do gráfico" Style="{StaticResource CaptionText}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ChartWindowSeconds, StringFormat={}{0:0.0} s}"
                                   Style="{StaticResource CaptionText}"
                                   FontFamily="{StaticResource MonoFont}" />
                    </DockPanel>
                    <Slider Style="{StaticResource FlatSlider}"
                            Minimum="3" Maximum="12"
                            Value="{Binding ChartWindowSeconds}" />

                    <StackPanel Margin="0,16,0,0">
                        <CheckBox Style="{StaticResource FlatCheckBox}"
                                  Content="Mostrar curva do acelerador"
                                  IsChecked="{Binding ShowThrottleTrace}"
                                  Margin="0,0,0,10" />
                        <CheckBox Style="{StaticResource FlatCheckBox}"
                                  Content="Alinhar por distância percorrida (iRacing)"
                                  IsChecked="{Binding UseIRacingAlignment}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= Controlador ================= -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="CONTROLADOR DE PEDIAIS" Style="{StaticResource SectionText}" />

                    <CheckBox Style="{StaticResource FlatCheckBox}"
                              Content="Usar pedais simulados (sem hardware)"
                              IsChecked="{Binding UseSimulatedPedals}"
                              Margin="0,14,0,0" />

                    <TextBlock Text="Controladores detectados" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="DisplayName" />

                    <DockPanel Margin="0,8,0,0">
                        <Button Content="Procurar novamente"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshDevicesCommand}" />
                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <TextBlock Text="MODELO DE PEDAL" Style="{StaticResource SectionText}" />
                    <TextBlock Text="Escolha o conjunto que você usa: o app ajusta curva, zona morta e filtro para o hardware."
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,6" />

                    <ComboBox Style="{StaticResource FlatComboBox}"
                              ItemsSource="{Binding PedalModels}"
                              SelectedItem="{Binding SelectedPedalModel}"
                              DisplayMemberPath="DisplayName" />

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding PedalProfileText}"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetectedModelText}"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Aplicar ajustes do modelo"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ApplyPedalProfileCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Usar detectado"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding UseDetectedModelCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <TextBlock Text="PRIMEIROS PASSOS" Style="{StaticResource SectionText}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0">
                        <Run Text="1." FontWeight="Bold" /><Run Text=" Calibre os pedais na aba Calibração." /><LineBreak />
                        <Run Text="2." FontWeight="Bold" /><Run Text=" Carregue uma volta de referência (CSV/JSON) ou use a volta demo." /><LineBreak />
                        <Run Text="3." FontWeight="Bold" /><Run Text=" Abra o iRacing: a velocidade aparece automaticamente." /><LineBreak />
                        <Run Text="4." FontWeight="Bold" /><Run Text=" Freie e acompanhe a nota de precisão curva a curva." />
                    </TextBlock>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= Ações ================= -->
        <Border Grid.Row="2" Style="{StaticResource RaisedCardBorder}" Margin="0,14,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Restaurar padrões"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetDefaultsCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Salvar"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Carregar volta demo"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding LoadDemoCommand}"
                            Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Message}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
