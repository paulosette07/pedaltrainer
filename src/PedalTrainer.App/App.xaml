<Application x:Class="PedalTrainer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PedalTrainer.App.Views"
             xmlns:viewModels="clr-namespace:PedalTrainer.App.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource FlatScrollBar}" />

            <DataTemplate DataType="{x:Type viewModels:TrainingViewModel}">
                <views:TrainingView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:DrillViewModel}">
                <views:DrillView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:CalibrationViewModel}">
                <views:CalibrationView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
